---
import "@fontsource-variable/instrument-sans";
import instrumentSansUrl from "@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url";
import "../styles/global.css";

interface Props {
  description?: string;
  title: string;
}

const {
  description = "A software development company for humans and agents.",
  title,
} = Astro.props;
---

<!doctype html>
<html
  lang="en"
  class="scheme-light-dark bg-white font-['Instrument_Sans_Variable'] text-neutral-950 antialiased dark:bg-neutral-950 dark:text-neutral-100"
>
  <head>
    <meta charset="utf-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link
      rel="preload"
      href={instrumentSansUrl}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="m-0 min-w-80 selection:bg-[#D9FF4A] selection:text-neutral-950">
    <slot />
  </body>
</html>
