---
import Layout from "../layouts/layout.astro"
---

<Layout title="Metaideas">
  <main class="flex min-h-svh flex-col">
    <section
      class="grid min-h-72 flex-1 place-items-center p-[clamp(2rem,6vw,6rem)]"
      aria-label="Metaideas"
    >
      <div class="grid justify-items-center gap-7 text-center">
        <div
          class="isolate grid aspect-square w-[clamp(9rem,19vw,13rem)] place-items-center bg-[#D9FF4A]"
        >
          <img
            class="h-auto w-[68%] animate-spin [animation-duration:60s] motion-reduce:animate-none"
            src="/logo.svg"
            width="512"
            height="512"
            alt=""
          />
        </div>
        <p class="m-0 max-w-96 text-[clamp(1rem,1.5vw,1.125rem)] leading-[1.45]">
          Developing better software<br />for humans and agents.
        </p>
      </div>
    </section>

    <footer
      class="flex flex-wrap items-center justify-center gap-x-2.5 gap-y-2 px-5 pt-4 pb-[max(1rem,env(safe-area-inset-bottom))] text-center text-[0.9375rem] leading-[1.45]"
      aria-labelledby="company-name"
    >
      <h1 class="m-0 whitespace-nowrap font-semibold tracking-tight" id="company-name">
        Metaideas
      </h1>

      <span class="text-neutral-300 dark:text-neutral-700" aria-hidden="true">|</span>

      <address class="whitespace-nowrap not-italic">
        30 N Gould St. Ste. R, Sheridan, WY 82801
      </address>

      <span class="text-neutral-300 dark:text-neutral-700" aria-hidden="true">|</span>

      <a
        class="inline-flex w-fit touch-manipulation items-center whitespace-nowrap decoration-transparent decoration-2 underline-offset-4 transition-[text-decoration-color] duration-150 ease-in-out hover:decoration-[#D9FF4A] focus-visible:rounded-xs focus-visible:outline-2 focus-visible:outline-offset-3 motion-reduce:transition-none"
        href="tel:+15512732773"
      >
        +1 (551) 273-2773
      </a>

      <span class="text-neutral-300 dark:text-neutral-700" aria-hidden="true">|</span>

      <a
        class="inline-flex w-fit touch-manipulation items-center whitespace-nowrap decoration-transparent decoration-2 underline-offset-4 transition-[text-decoration-color] duration-150 ease-in-out hover:decoration-[#D9FF4A] focus-visible:rounded-xs focus-visible:outline-2 focus-visible:outline-offset-3 motion-reduce:transition-none"
        href="mailto:hello@metaideas.io"
      >
        hello@metaideas.io
      </a>
    </footer>
  </main>
</Layout>
